# ---------------------------------------------------------------------------
# Local: a SQLite file, zero setup.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Vercel: the filesystem is per-invocation, so a file: URL means the staff
# screen never sees a submission. Point at Turso (hosted libSQL — still SQLite)
# and the rest of the app is unchanged.
#
#   npm i -g @tursodatabase/turso   # or: brew install tursodatabase/tap/turso
#   turso db create yosi-booth
#   turso db show yosi-booth --url
#   turso db tokens create yosi-booth
# ---------------------------------------------------------------------------
# DATABASE_URL="libsql://yosi-booth-you.turso.io"
# TURSO_AUTH_TOKEN="..."

# Absolute origin used in the SMS links. Vercel sets the host header correctly,
# so this is only needed behind a tunnel (ngrok) or a custom domain.
# PUBLIC_BASE_URL="https://booth.yosicare.com"

# Twilio. Leave unset and every outbound text is logged to the server console
# instead of sent — the demo still runs end to end.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+12145550148"

# Gate on /admin and /staff. Unset means open, which is fine on a booth laptop
# and not fine on a public URL.
# BOOTH_PASSCODE="lakeview"
